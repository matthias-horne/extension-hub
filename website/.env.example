# Include extensions that have no OCI manifest registry. Set to false to hide them.
VITE_SHOW_EXTENSIONS_WITHOUT_REGISTRY=true

# Giscus comments on extension compatibility pages. Set the IDs from https://giscus.app
# (install the giscus GitHub App and enable Discussions on the repository first).
# Comments are hidden when VITE_GISCUS_REPO_ID or VITE_GISCUS_CATEGORY_ID is unset.
VITE_GISCUS_REPO=matthias-horne/extension-hub
VITE_GISCUS_REPO_ID=
VITE_GISCUS_CATEGORY=General
VITE_GISCUS_CATEGORY_ID=
